# Copy this to apps/api/.env for local development, using fictional data only.
SMS_ENVIRONMENT=development
SMS_DEBUG=false
SMS_ENABLE_LEARNING_ENDPOINTS=true
SMS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Staging/production reject debug and learning endpoints; use HTTPS CORS origins.
# Database and Firebase settings will be added with their respective milestones.
# Never put real credentials in this example file.
